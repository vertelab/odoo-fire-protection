<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fire_protection_object_tree" model="ir.ui.view">
        <field name="name">fire.protection.object.tree</field>
        <field name="model">fire.protection.object</field>
        <field name="arch" type="xml">
            <list decoration-danger="lifecycle_stage == 'overdue'" decoration-warning="lifecycle_stage in ('due_service', 'due_overhaul', 'due_replacement')">
                <field name="unique_id"/>
                <field name="name"/>
                <field name="object_type"/>
                <field name="location_id"/>
                <field name="status"/>
                <field name="lifecycle_stage"/>
                <field name="next_service_date"/>
                <field name="next_replacement_date"/>
            </list>
        </field>
    </record>
    <record id="view_fire_protection_object_form" model="ir.ui.view">
        <field name="name">fire.protection.object.form</field>
        <field name="model">fire.protection.object</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_service_done" string="Service Done" type="object" class="btn-primary"/>
                    <button name="action_report_deficiency" string="Report Deficiency" type="object" invisible="status == 'deficient'"/>
                    <button name="action_mark_critical" string="Mark Critical" type="object" invisible="status == 'critical'"/>
                    <button name="action_retire" string="Retire" type="object" invisible="lifecycle_stage == 'retired'"/>
                    <field name="lifecycle_stage" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <field name="qr_code" widget="image" class="oe_avatar"/>
                        <h1><field name="name" placeholder="Object Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="unique_id"/>
                            <field name="object_type"/>
                            <field name="location_id"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="manufacture_date"/>
                            <field name="install_date"/>
                            <field name="last_service_date"/>
                            <field name="service_interval_months"/>
                        </group>
                    </group>
                    <group string="Lifecycle">
                        <field name="next_service_date"/>
                        <field name="next_replacement_date"/>
                        <field name="replacement_5year_date"/>
                        <field name="replacement_10year_date"/>
                        <field name="replacement_20year_date"/>
                    </group>
                    <group string="Connections">
                        <field name="floorplan_id"/>
                        <field name="maintenance_equipment_id"/>
                        <field name="product_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_fire_protection_object_kanban" model="ir.ui.view">
        <field name="name">fire.protection.object.kanban</field>
        <field name="model">fire.protection.object</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="object_type"/>
                <field name="status"/>
                <field name="lifecycle_stage"/>
                <field name="unique_id"/>
                <field name="qr_code"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click"
                             t-att-class="'oe_kanban_card oe_kanban_global_click ' + (record.status.raw_value == 'critical' ? 'oe_kanban_card_red' : record.status.raw_value == 'deficient' ? 'oe_kanban_card_yellow' : '')">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('fire.protection.object', 'qr_code', record.id.raw_value)"
                                     t-if="record.qr_code.raw_value" width="48" height="48"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="text-muted"><field name="unique_id"/></div>
                                <div class="o_kanban_tags">
                                    <span class="badge" t-att-class="'badge bg-' + (record.status.raw_value == 'ok' ? 'success' : record.status.raw_value == 'deficient' ? 'warning' : record.status.raw_value == 'critical' ? 'danger' : 'secondary')">
                                        <field name="status"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_fire_protection_object" model="ir.actions.act_window">
        <field name="name">Brandskyddsobjekt</field>
        <field name="res_model">fire.protection.object</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
