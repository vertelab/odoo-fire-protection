<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_form_inherit_fire" model="ir.ui.view">
        <field name="name">res.partner.form.fire</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Brandskydd">
                    <field name="fire_safety_rating"/>
                    <field name="fire_responsible_person_id"/>
                    <field name="fire_last_inspection_date"/>
                    <field name="fire_next_inspection_date"/>
                    <field name="fire_object_count"/>
                    <field name="fire_deficiencies_count"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
