<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fire_protection_floorplan_tree" model="ir.ui.view">
        <field name="name">fire.protection.floorplan.tree</field>
        <field name="model">fire.protection.floorplan</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="location_id"/><field name="floor_number"/><field name="hotspot_count"/></list>
        </field>
    </record>
    <record id="view_fire_protection_floorplan_form" model="ir.ui.view">
        <field name="name">fire.protection.floorplan.form</field>
        <field name="model">fire.protection.floorplan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Floor Plan Name"/></h1></div>
                    <group>
                        <field name="location_id"/>
                        <field name="floor_number"/>
                        <field name="building_section"/>
                    </group>
                    <group string="Floor Plan Image">
                        <field name="image" widget="image" class="img-fluid"/>
                        <field name="image_filename" invisible="1"/>
                    </group>
                    <group string="Hotspots">
                        <field name="hotspot_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="object_id"/>
                                <field name="x"/>
                                <field name="y"/>
                                <field name="status_color"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_fire_protection_hotspot_tree" model="ir.ui.view">
        <field name="name">fire.protection.hotspot.tree</field>
        <field name="model">fire.protection.hotspot</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="object_id"/><field name="x"/><field name="y"/><field name="status_color"/></list>
        </field>
    </record>
    <record id="action_fire_protection_floorplan" model="ir.actions.act_window">
        <field name="name">Planritningar</field>
        <field name="res_model">fire.protection.floorplan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
