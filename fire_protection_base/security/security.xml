<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fire_protection" model="ir.module.category">
        <field name="name">Brandskydd (Fire Protection)</field>
        <field name="description">Brandskydd — systematiskt brandskyddsarbete och objekthantering</field>
        <field name="sequence">80</field>
    </record>
    <record id="group_fire_protection_user" model="res.groups">
        <field name="name">Fire Protection User</field>
        <field name="category_id" ref="module_category_fire_protection"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_fire_protection_manager" model="res.groups">
        <field name="name">Fire Protection Manager</field>
        <field name="category_id" ref="module_category_fire_protection"/>
        <field name="implied_ids" eval="[(4, ref('group_fire_protection_user'))]"/>
    </record>
    <record id="group_fire_protection_officer" model="res.groups">
        <field name="name">Fire Protection Officer</field>
        <field name="category_id" ref="module_category_fire_protection"/>
        <field name="implied_ids" eval="[(4, ref('group_fire_protection_manager'))]"/>
    </record>
    <record id="rule_fire_object_company" model="ir.rule">
        <field name="name">Fire Object: Company Isolation</field>
        <field name="model_id" ref="model_fire_protection_object"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
